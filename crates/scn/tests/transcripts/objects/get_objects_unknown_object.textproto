# A named object the ticket's walk did not reach: the reply ends with
# NOT_FOUND in the stream, after any object before it (section 7.3).
since: v0.1
method: Objects/GetObjects
fixture: landed

request.ticket: $ticket
request.refs: kind=blob id=$blob path=src/main.rs
request.refs: kind=blob id=$missing path=src/gone.rs

tiers: fresh

status: ok
objects: kind=blob id=$blob
end: stream=not_found
